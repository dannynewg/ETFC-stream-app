rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function admin() { return authenticated() && request.auth.token.admin == true; }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function profileFields() {
      return ['displayName', 'handle', 'phoneNumber', 'countryCode', 'flagEmoji',
              'lastLoginTimestamp', 'updatedAt'];
    }
    match /{collection}/{id} {
      allow read: if collection in ['fighters', 'matches', 'hero_slides',
        'previous_fight_videos', 'news_announcements'];
      allow write: if admin() && collection in ['fighters', 'matches', 'hero_slides',
        'previous_fight_videos', 'news_announcements'];
    }
    match /admin_invites/{email} {
      allow read, write: if admin();
    }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if admin() || (owner(uid) &&
        request.resource.data.keys().hasOnly(profileFields().concat(['userId', 'email', 'role', 'createdTimestamp'])) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'user');
      allow update: if admin() || (owner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields()));
      allow delete: if admin();
    }
    match /ppv_passes/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    match /arena_chat/{id} {
      allow read: if true;
      allow create: if authenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if admin();
      allow delete: if admin() || (authenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
