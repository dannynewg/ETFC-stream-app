rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'dannynewg@gmail.com' ||
        exists(/databases/$(database)/documents/admin_invites/$(request.auth.token.email))
      );
    }

    // Public read for MMA match cards, fighters, hero promo slides, fight videos, and news
    // Write access restricted strictly to Admin accounts
    match /fighters/{fighterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /previous_fight_videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news_announcements/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin team invites: only existing admins can read/write invite tokens
    match /admin_invites/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User accounts collection: users can read and edit their own profile, admins can read all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Live arena chat: all users can read; authenticated users can send messages; admins can delete/pin
    match /arena_chat/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
