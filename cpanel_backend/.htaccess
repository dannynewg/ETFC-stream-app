# =============================================================================
# ETFC STREAMING PLATFORM - CPANEL APACHE HTACCESS
# =============================================================================

RewriteEngine On

# PHP applies the configured origin and handles preflight requests.
# This baseline is not a complete hosting/vhost deployment configuration.
RewriteRule ^(?:config|database)(?:/|$) - [F,L]

# Prevent directory browsing
Options -Indexes

# Protect sensitive files and folders
<FilesMatch "(^\.env|\.sql|\.json|\.log|config\.php)$">
    Require all denied
</FilesMatch>
